# Optional Jupiter API key. Set it if keyless requests are unavailable or rate limited.
JUPITER_API_KEY=

# HTTPS Solana MAINNET RPC. Never use a devnet RPC for Jupiter mainnet swaps.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional absolute path to your local Solana CLI keypair JSON file.
# A wallet is loaded automatically from this variable only for trade --execute.
# CHROMA_WALLET=C:/Users/your-name/.config/solana/id.json
