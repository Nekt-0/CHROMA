    { "name": "Claude", "url": "https://claude.ai" }
  ],
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nekt-0/CHROMA.git"
  },
  "keywords": [
    "solana",
    "scanner",
    "terminal",
    "research",
    "chroma"
  ],
  "dependencies": {
    "@solana/web3.js": "1.99.0"
  }
}
