{
  "name": "chroma-scan",
  "version": "0.2.0",
  "description": "CHROMA — Solana scanning, explainable checks and explicit Jupiter swap execution with traceable receipts.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "chroma": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs demo",
    "demo": "node src/cli.mjs demo --once",
    "scan": "node src/cli.mjs scan --discover",
    "watch": "node src/cli.mjs watch --discover",
    "test": "node --test",
    "check": "node scripts/check.mjs"
  },
